# ---- Required in production -------------------------------------------------
MONGO_URL=
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=
# How long logins last (vercel/ms format, e.g. 12h, 7d).
JWT_EXPIRES_IN=7d

# ---- Photo storage (AWS S3) --------------------------------------------------
# Photos are uploaded with presigned URLs, so the bucket can stay private.
# The IAM user needs s3:PutObject and s3:GetObject on the bucket.
# Run `npm run s3:cors` once to allow browser uploads.
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=mernbnb-images-bucket
S3_REGION=eu-west-1
# Only for S3-compatible services (MinIO, local emulators). Leave unset for AWS.
S3_ENDPOINT=

# ---- Optional ------------------------------------------------------------------
# NODE_ENV=production        # Vercel sets this for you
# PORT=5000
# LOG_LEVEL=info             # fatal|error|warn|info|debug|trace|silent
# Extra origins allowed to call the API cross-origin (comma-separated).
# The client normally calls /api on its own origin and doesn't need this.
# CORS_ORIGINS=https://mernbnb.vercel.app,https://kibe-mernbnb.vercel.app
# Proxies in front of the API (Vercel: 1). Needed to rate limit by real IP.
# TRUST_PROXY=1
# Rate limits (per IP; writes/uploads per user). Window is 15 minutes.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10     # failed logins/registrations per window
# WRITE_RATE_LIMIT_MAX=30    # listings + bookings per hour
# UPLOAD_RATE_LIMIT_MAX=60   # upload requests per hour
