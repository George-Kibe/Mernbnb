MONGO_URL=

# AWS S3 photo storage. Photos are uploaded with presigned URLs, so the bucket
# can stay private. Run `npm run s3:cors` once to allow browser uploads.
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=mernbnb-images-bucket
S3_REGION=eu-west-1
# Only for S3-compatible services (MinIO, local emulators). Leave unset for AWS.
S3_ENDPOINT=
